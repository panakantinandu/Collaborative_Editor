# Supabase: transaction pooler (port 6543), with pgbouncer=true
DATABASE_URL="postgresql://postgres.PROJECT:PASSWORD@POOLER_HOST:6543/postgres?pgbouncer=true&connection_limit=5"
# Supabase: direct connection or session pooler (port 5432) for migrations
DIRECT_URL="postgresql://postgres.PROJECT:PASSWORD@POOLER_HOST:5432/postgres"
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="replace-with-at-least-32-random-characters"
# Must exactly match the public deployment origin; no trailing slash
APP_ORIGIN="http://127.0.0.1:3000"
